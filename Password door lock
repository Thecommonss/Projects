
const int ledg = 9;
const int ledr = 10;

const int buzzer = 6;


const int button1 = 2;
const int button2 = 3;
const int button3 = 4;
const int button4 = 5;
bool lastbtn1 = HIGH;
bool lastbtn2 = HIGH;
bool lastbtn3 = HIGH;
bool lastbtn4 = HIGH;


int tries = 0;
// if tries == 3
// the system will be locked out


int currentstatus = 0;
// status = 0 : waiting for input
// 1 : Access granted
// 2 : Access denied
// 3 : Locked out


int password[4] = {1,3,2,4};
int entered[4];
int enteredcount = 0;

void setup() {
  
  pinMode(ledg,OUTPUT);
  pinMode(ledr,OUTPUT);
  
  pinMode(buzzer,OUTPUT);
  
  pinMode(button1,INPUT_PULLUP);
  pinMode(button2,INPUT_PULLUP);
  pinMode(button3,INPUT_PULLUP);
  pinMode(button4,INPUT_PULLUP);
  
  Serial.begin(9600);
  
}


void checkpassword() {
  bool correct = true;
  for (int i = 0;i < 4;i++) {
    if (entered[i] != password[i]) {
        correct = false;
  }
  }
    if (correct) {
      Serial.println("Access Granted");
      currentstatus = 1;
    }
    else {
      Serial.println("Access Denied");
      currentstatus = 2;
    }
    enteredcount = 0; // Reset password input
}


void readbuttons() {
  bool b1 = digitalRead(button1);
  bool b2 = digitalRead(button2);
  bool b3 = digitalRead(button3);
  bool b4 = digitalRead(button4);
  
  if (b1 == LOW && lastbtn1 == HIGH) {
    Serial.println("Button 1 pressed");
    entered[enteredcount] = 1;
    enteredcount++;
    Serial.print("Entered: ");
    Serial.println(enteredcount);
    if (enteredcount == 4) checkpassword();
    delay(50);
  }
  else if (b2 == LOW && lastbtn2 == HIGH) {
    Serial.println("Button 2 pressed");
    entered[enteredcount] = 2;
    enteredcount++;
    Serial.print("Entered: ");
    Serial.println(enteredcount);
    if (enteredcount == 4) checkpassword();
    delay(50);
  }
  else if (b3 == LOW && lastbtn3 == HIGH) {
    Serial.println("Button 3 pressed");
    entered[enteredcount] = 3;
    enteredcount++;
    Serial.print("Entered: ");
    Serial.println(enteredcount);
    if (enteredcount == 4) checkpassword();
    delay(50);
  }
  else if (b4 == LOW && lastbtn4 == HIGH) {
    Serial.println("Button 4 pressed");
    entered[enteredcount] = 4;
    enteredcount++;
    Serial.print("Entered: ");
    Serial.println(enteredcount);
    if (enteredcount == 4) checkpassword();
    delay(50);
  }
  lastbtn1 = b1;
  lastbtn2 = b2;
  lastbtn3 = b3;
  lastbtn4 = b4;
}     

void loop() {

  if (currentstatus == 0) {
    // Waiting for user input
    // button1 = 1
    // button2 = 2
    // .... so on
	readbuttons();
   
  }
  else if (currentstatus == 1) {
    digitalWrite(ledg,HIGH);
    delay(3000);
    digitalWrite(ledg,LOW);
    tries = 0;
    currentstatus = 0;
    Serial.println("Welcome, System reset");
    
  }
  else if (currentstatus == 2) {
    digitalWrite(ledr,HIGH);
    digitalWrite(buzzer,HIGH);
    delay(500);
    digitalWrite(buzzer,LOW);
    delay(5000);
    digitalWrite(ledr,LOW);
    tries++;
    if (tries == 3) {
    currentstatus = 3;
  }
    else {
      currentstatus = 0;
      Serial.println("Please Try again");
    }
    
    
  }
  
  else if (currentstatus == 3) {
    Serial.println("System locked out");
    for (int i = 0;i < 10;i++) {
      digitalWrite(ledr,HIGH);
      digitalWrite(buzzer,HIGH);
      delay(500);
      digitalWrite(ledr,LOW);
      digitalWrite(buzzer,LOW);
      delay(500);
      
    }
    tries = 0;
    currentstatus = 0;
    Serial.println("Please try again");
  }
  delay(10);
}

